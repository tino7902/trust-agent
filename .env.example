# ─────────────────────────────────────────────────────────────────────────────
# Trust Agent — variables de entorno
#
#   cp .env.example .env    y completá las dos claves.
#
# Estas cuatro son todas las que el proyecto usa. Nunca commitees este archivo
# con valores reales: .env está en .gitignore y debe quedarse ahí.
# ─────────────────────────────────────────────────────────────────────────────

# ── Modelo, vía OpenRouter ───────────────────────────────────────────────────
# Clave: https://openrouter.ai/keys
# El modelo TIENE que soportar tool calling, o el agente no puede buscar.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
MODEL=openai/gpt-5-mini

# ── Búsqueda con Exa ─────────────────────────────────────────────────────────
# Clave: https://dashboard.exa.ai/api-keys
# Sin esto el agente avisa que no puede verificar, en lugar de inventar fuentes.
EXA_API_KEY=
# 'fast' (~450ms) es lo máximo tolerable en un panel. 'deep-reasoning' tarda
# hasta 40 segundos y se lee como si la app se hubiera colgado.
EXA_SEARCH_TYPE=fast

# ── Heredadas del starter kit, sin usar en Trust Agent ───────────────────────
# AMBIGUOUS_API_KEY=       # registros persistentes (apps/web followups)
# CHANNEL_CODE=            # plantilla de Slack (apps/channel)
# INTELLIGENCE_API_KEY=    # CopilotKit Intelligence
# OPENAI_API_KEY=          # solo la ruta /voice heredada

LOG_LEVEL=debug
