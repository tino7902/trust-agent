# ─────────────────────────────────────────────────────────────────────────────
# Trust Agent — variables de entorno
#
#   cp .env.example .env    y completá las claves requeridas.
#
# Este archivo es el contrato de configuración: debe contener las mismas
# variables que .env. Conservá acá los valores por defecto que no sean secretos
# y dejá vacías todas las claves, tokens y URLs privadas. Nunca commitees .env:
# está en .gitignore y debe quedarse ahí.
# ─────────────────────────────────────────────────────────────────────────────

# ── Modelo, vía OpenRouter ───────────────────────────────────────────────────
# Clave: https://openrouter.ai/keys
# El modelo TIENE que soportar tool calling, o el agente no puede buscar.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
MODEL=openai/gpt-5-mini
# GPT-5 reasoning effort: low reduces latency while preserving tool use.
# Allowed values: minimal, low, medium, high. Use low for the side panel.
MODEL_REASONING_EFFORT=low

# ── Búsqueda con Exa ─────────────────────────────────────────────────────────
# Clave: https://dashboard.exa.ai/api-keys
# Sin esto el agente avisa que no puede verificar, en lugar de inventar fuentes.
EXA_API_KEY=
# 'instant' (~250ms) keeps the side panel responsive. Use 'fast' (~450ms) only
# when a deployment explicitly prefers more search coverage.
EXA_SEARCH_TYPE=instant

# ── Heredadas del starter kit, sin usar en Trust Agent ───────────────────────
# AMBIGUOUS_API_KEY=       # registros persistentes (apps/web followups)
# CHANNEL_CODE=            # plantilla de Slack (apps/channel)
# INTELLIGENCE_API_KEY=    # CopilotKit Intelligence
# OPENAI_API_KEY=          # solo la ruta /voice heredada

LOG_LEVEL=debug
